# ---------------------------------------------------------------
# Unity — generated / machine-local folders.
# These are rebuilt by the editor from Assets/ + ProjectSettings/ +
# Packages/, so committing them is pure noise (Library/ alone is often
# several hundred MB) and a frequent source of merge conflicts.
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tooling
/[Aa]ssets/AssetStoreTools*

# Unity crash-recovery autosaves
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# ---------------------------------------------------------------
# IDE / build tooling
# ---------------------------------------------------------------
.vs/
.gradle/
.idea/
.vscode/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---------------------------------------------------------------
# Builds / packages
# ---------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app

# Crash reports
sysinfo.txt
crashlytics-build.properties
